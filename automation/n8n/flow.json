{
  "name": "eSIMRanker Weekly Roundup",
  "nodes": [
    {
      "parameters": {
        "cronExpression": "0 9 * * 1"
      },
      "name": "Weekly Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://YOUR_DOMAIN/plans.json",
        "responseFormat": "json"
      },
      "name": "Fetch plans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "functionCode": "const plans=items[0].json; const top=plans.slice(0,10).map(p=>`#${p.rank} ${p.provider} ${p.plan_name} (${p.region}) \u2014 $${p.price_usd} \u2192 ${p.product_url}`).join('\\n'); return [{json:{subject:'Top eSIM Plans This Week', body: top}}];"
      },
      "name": "Compose",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "subject": "={{$json[\"subject\"]}}",
        "text": "={{$json[\"body\"]}}"
      },
      "name": "MailerLite",
      "type": "n8n-nodes-base.mailerlite",
      "typeVersion": 1,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "text": "={{$json[\"body\"]}}"
      },
      "name": "Twitter/X",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 2,
      "position": [
        400,
        120
      ]
    }
  ],
  "connections": {
    "Weekly Cron": {
      "main": [
        [
          {
            "node": "Fetch plans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch plans": {
      "main": [
        [
          {
            "node": "Compose",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose": {
      "main": [
        [
          {
            "node": "MailerLite",
            "type": "main",
            "index": 0
          },
          {
            "node": "Twitter/X",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}